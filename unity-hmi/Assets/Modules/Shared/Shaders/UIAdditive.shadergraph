{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "578a2c3dee7f40f2ba0c0dc3bca33133",
    "m_Title": "Shine",
    "m_Content": "Shine (i.e. the brightest pixels) is isolated as a mask and used to boost the brightness of pixels, after the normal multiply tint.\n\nThis preserves the bright shine and keeps it white even after the multiply has been applied.",
